<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="17dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="30dp" android:layout_height="33dp" android:layout_gravity="center_vertical">
            <ImageView android:id="@+id/mark_edge" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_mark" />
            <ImageView android:id="@+id/mark_face" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_mark" />
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="ب" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        </FrameLayout>
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/widget_loading" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="8dp" android:layout_gravity="center_vertical">
            <ImageView android:id="@+id/count_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_pill" />
            <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="22dp" android:gravity="center" android:paddingStart="11dp" android:paddingEnd="11dp" android:textSize="12sp" android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <FrameLayout android:id="@+id/widget_add" android:layout_width="38dp" android:layout_height="41dp" android:layout_gravity="center_vertical">
            <ImageView android:id="@+id/fab_edge" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_fab" />
            <ImageView android:id="@+id/fab_face" android:layout_width="38dp" android:layout_height="38dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_fab" />
            <TextView android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
        <FrameLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/row1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_row" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageView android:id="@+id/row1_dot" android:layout_width="10dp" android:layout_height="10dp" android:importantForAccessibility="no" android:src="@drawable/tint_circle" />
                <TextView android:id="@+id/row1_t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/row1_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/row2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_row" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageView android:id="@+id/row2_dot" android:layout_width="10dp" android:layout_height="10dp" android:importantForAccessibility="no" android:src="@drawable/tint_circle" />
                <TextView android:id="@+id/row2_t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/row2_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/row3_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_row" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageView android:id="@+id/row3_dot" android:layout_width="10dp" android:layout_height="10dp" android:importantForAccessibility="no" android:src="@drawable/tint_circle" />
                <TextView android:id="@+id/row3_t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/row3_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/row4_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_row" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageView android:id="@+id/row4_dot" android:layout_width="10dp" android:layout_height="10dp" android:importantForAccessibility="no" android:src="@drawable/tint_circle" />
                <TextView android:id="@+id/row4_t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/row4_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/widget_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/widget_text_secondary" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="12sp" android:textStyle="bold" />
        <FrameLayout android:id="@+id/sug_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <ImageView android:id="@+id/sug_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_sug" />
            <TextView android:id="@+id/widget_suggestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:padding="11dp" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </FrameLayout>
</LinearLayout>

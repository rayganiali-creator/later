<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="15dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="30dp" android:layout_height="33dp" android:layout_gravity="center_vertical">
            <ImageView android:id="@+id/mark_edge" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_mark" />
            <ImageView android:id="@+id/mark_face" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_mark" />
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="ب" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        </FrameLayout>
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" />
            <FrameLayout android:id="@+id/widget_add" android:layout_width="32dp" android:layout_height="35dp" android:layout_gravity="center_vertical">
            <ImageView android:id="@+id/fab_edge" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_fab" />
            <ImageView android:id="@+id/fab_face" android:layout_width="32dp" android:layout_height="32dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_fab" />
            <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textSize="40sp" android:textStyle="bold" />
        <FrameLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/row1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/tint_row" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageView android:id="@+id/row1_dot" android:layout_width="10dp" android:layout_height="10dp" android:importantForAccessibility="no" android:src="@drawable/tint_circle" />
                <TextView android:id="@+id/row1_t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/row1_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/widget_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/widget_text_secondary" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
